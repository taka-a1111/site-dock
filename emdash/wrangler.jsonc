{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sukizero-site",
	"main": "./src/worker.ts",
	// 管理者の初期設定が済むまで、仮URLは外から開けないようにしておく
	"workers_dev": false,
	"preview_urls": false,
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sukizero-site",
			"database_id": "bfd04563-0130-42e4-aa30-d36adf19ee5e",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "sukizero-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
